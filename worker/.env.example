# Apply worker config. Copy to .env (gitignored) and fill in the key.
#
# The service-role key bypasses RLS and can read any candidate's résumé. Keep it
# in this file rather than on a command line, where it would land in your shell
# history.
SUPABASE_URL="https://bwhdazbotpblihdxcmho.supabase.co"

# Supabase -> Project Settings -> API -> service_role (NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=""

# Leave once the queue has been dry this long. 120000 = 2 minutes.
# `applyd once` sets this; `applyd watch` clears it so the browser stays open.
WORKER_IDLE_EXIT_MS="120000"

# Pause between applications. Not evasion — plain courtesy to an employer's
# server, and it stops one candidate's batch looking like a burst.
APPLY_GAP_MS="20000"
