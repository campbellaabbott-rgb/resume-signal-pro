#!/bin/bash
# Apply worker, on a Mac. One command for each thing you actually do.
#
#   ./mac/applyd arm       paste the secret once; verifies, then installs
#   ./mac/applyd arm-visible  same, but echoes the paste (if yours won't paste
#                             into a hidden prompt). Nobody watching, please.
#   ./mac/applyd check     what the queue says right now (no browser)
#   ./mac/applyd once      one pass: send what's waiting, then exit
#   ./mac/applyd watch     headed + slowed, so you can WATCH a submission
#   ./mac/applyd install   run every 5 minutes via launchd
#   ./mac/applyd uninstall stop doing that
#   ./mac/applyd status    is it scheduled, did it run, what did it say
#   ./mac/applyd smoke     check the worker and broker agree (submits nothing)
#   ./mac/applyd logs      tail the log
#
# It reads worker/.env, which is gitignored. That file used to hold a
# service-role key; it no longer can. The backend is Lovable Cloud-managed and
# injects that key into edge functions at runtime, where nobody can retrieve it.
# Every privileged operation now goes through the apply-broker edge function,
# and this worker holds only APPLY_BROKER_URL + APPLY_WORKER_SECRET — a
# credential that can claim and release application packets and nothing else.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LABEL="work.resumebooster.apply"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HERE/mac/apply.log"

need_env() {
  if [ ! -f "$HERE/.env" ]; then
    echo "  worker/.env is missing."
    echo "  cp worker/.env.example worker/.env  and fill in the two broker values."
    exit 2
  fi
  set -a; . "$HERE/.env"; set +a
  MISSING=""
  [ -z "${APPLY_BROKER_URL:-}" ]    && MISSING="$MISSING APPLY_BROKER_URL"
  [ -z "${APPLY_WORKER_SECRET:-}" ] && MISSING="$MISSING APPLY_WORKER_SECRET"
  if [ -n "$MISSING" ]; then
    echo "  missing in worker/.env:$MISSING"
    echo "  URL:    https://<project>.supabase.co/functions/v1/apply-broker"
    echo "  SECRET: Lovable -> Backend -> Secrets -> APPLY_WORKER_SECRET"
    exit 2
  fi
}

case "${1:-}" in
  check)
    need_env
    # Probes BEHAVIOUR, not reachability. A 401 and an empty queue are different
    # facts that used to be easy to confuse, so they print differently here.
    BODY='{"action":"ping","worker_id":"applyd-check","version":"check","claimed":0}'
    CODE=$(curl -s -o /tmp/applyd-check.out -w "%{http_code}" \
      -X POST "$APPLY_BROKER_URL" \
      -H "Authorization: Bearer $APPLY_WORKER_SECRET" \
      -H "Content-Type: application/json" -d "$BODY")
    case "$CODE" in
      200)
        echo "  broker reachable and the secret is accepted."
        # Now ask the question that decides whether a browser is worth starting.
        CBODY='{"action":"claim","worker_id":"applyd-check","version":"check"}'
        COUT=$(curl -s -X POST "$APPLY_BROKER_URL" \
          -H "Authorization: Bearer $APPLY_WORKER_SECRET" \
          -H "Content-Type: application/json" -d "$CBODY")
        case "$COUT" in
          *'"packet":null'*)
            echo "  nothing queued. A worker started now would exit without a browser." ;;
          *'"packet"'*)
            # NOTE: this claim took a 10-minute lease on a real packet. It will
            # be picked up by the next run once the lease lapses, or immediately
            # if you run `once` now.
            echo "  a packet is waiting — ./mac/applyd once will send it."
            echo "  (this check leased it for 10 minutes; run 'once' now or wait)" ;;
          *) echo "  unexpected claim response: $(echo "$COUT" | head -c 200)" ;;
        esac ;;
      401|403)
        echo "  broker rejected the secret ($CODE)."
        echo "  APPLY_WORKER_SECRET does not match the edge secret of the same name." ;;
      404)
        echo "  no broker at that URL ($CODE) — check APPLY_BROKER_URL." ;;
      000)
        echo "  could not reach the broker at all. Network, or a wrong host." ;;
      503)
        # NOT your .env. apply-broker returns 503 "broker not configured" when
        # ITS OWN APPLY_WORKER_SECRET is unset, and 401 when yours simply does
        # not match. Reporting both as "check your secret" sends someone to
        # re-paste a value that was never the problem.
        echo "  the BROKER has no secret configured on the server ($CODE)."
        echo "  Nothing you can fix here — set APPLY_WORKER_SECRET in Lovable -> Backend -> Secrets." ;;
      *)
        echo "  broker returned $CODE: $(head -c 200 /tmp/applyd-check.out)" ;;
    esac
    ;;

  arm|arm-visible)
    # One command between a fresh clone and a running sender.
    #
    # The secret is read from STDIN, never argv. An argument lands in shell
    # history and is visible in `ps` to every user on the machine, and this
    # credential can claim and release application packets.
    #
    # It INSTALLS ONLY IF THE BROKER ACCEPTS THE CREDENTIAL. Writing the file
    # and scheduling a job that will fail every five minutes is the arrangement
    # where a typo looks exactly like a working install until somebody reads a
    # log — which is the same failure this worker keeps being rescued from.
    if [ ! -f "$HERE/.env" ]; then
      [ -f "$HERE/.env.example" ] && cp "$HERE/.env.example" "$HERE/.env" || : > "$HERE/.env"
    fi
    chmod 600 "$HERE/.env"

    # ECHO A CHARACTER COUNT, NOT THE SECRET.
    #
    # The first version printed "input hidden" and read silently. Pasting into
    # it looks identical to a frozen terminal: no dots, no cursor movement,
    # nothing. Someone pastes, sees no response, presses Enter to make it
    # register, and gets an abort that scrolls past — the file is never written
    # and the next run reports the secret "missing", which reads as though the
    # paste was wrong rather than never delivered. That happened, and the
    # evidence was unambiguous: zero characters on disk, not a wrong value.
    #
    # So the prompt now says how many characters it received. That reveals a
    # length and nothing else — enough to see the paste landed, useless to
    # anyone reading over a shoulder.
    echo "  The secret is in Lovable -> Backend -> Secrets -> APPLY_WORKER_SECRET"
    if [ "${1:-}" = "arm-visible" ]; then
      echo "  VISIBLE MODE — the secret will be echoed as you paste it."
      printf "  Paste it now, then press Enter: "
      IFS= read -r SECRET
    else
      echo "  Paste is INVISIBLE — no dots will appear. That is normal."
      printf "  Paste it now, then press Enter: "
      IFS= read -rs SECRET
      echo
    fi
    if [ -z "$SECRET" ]; then
      echo
      echo "  Nothing arrived — .env untouched, nothing installed."
      echo "  The paste did not reach the prompt. Two things that cause it:"
      echo "    - Enter pressed before pasting (the input really is invisible)"
      echo "    - a terminal that blocks paste into a hidden prompt"
      echo
      echo "  If your terminal will not paste into a hidden prompt, use:"
      echo "      ./mac/applyd arm-visible"
      echo "  which echoes the secret as you type. Only do that with nobody"
      echo "  watching your screen, and clear the scrollback afterwards."
      exit 2
    fi
    echo "  received ${#SECRET} characters."

    # Preserve every other key; replace this one.
    TMP="$(mktemp)"
    grep -v '^APPLY_WORKER_SECRET=' "$HERE/.env" > "$TMP" 2>/dev/null || true
    printf 'APPLY_WORKER_SECRET="%s"\n' "$SECRET" >> "$TMP"
    # The broker URL is not a secret and the worker cannot guess it.
    if ! grep -q '^APPLY_BROKER_URL=' "$TMP"; then
      printf 'APPLY_BROKER_URL="https://bwhdazbotpblihdxcmho.supabase.co/functions/v1/apply-broker"\n' >> "$TMP"
    fi
    mv "$TMP" "$HERE/.env"
    chmod 600 "$HERE/.env"
    echo "  wrote worker/.env (mode 600, ${#SECRET} chars stored — value not echoed)"

    # Prove the credential against the real broker before scheduling anything.
    set -a; . "$HERE/.env"; set +a
    CODE=$(curl -s -o /tmp/applyd-arm.out -w "%{http_code}" \
      -X POST "$APPLY_BROKER_URL" \
      -H "Authorization: Bearer $APPLY_WORKER_SECRET" \
      -H "Content-Type: application/json" \
      -d '{"action":"ping","worker_id":"applyd-arm","version":"arm","claimed":0}')
    case "$CODE" in
      200)
        echo "  broker ACCEPTED the credential."
        "$0" install
        echo
        echo "  Armed. Next: ./mac/applyd watch   (headed, slowed — watch the first one go)"
        ;;
      401|403)
        echo "  broker REJECTED it ($CODE) — not installing."
        echo "  That value is not the edge secret named APPLY_WORKER_SECRET."
        exit 1 ;;
      503)
        echo "  the BROKER has no secret configured on the server ($CODE) — not installing."
        echo "  Nothing you can fix in this file." ; exit 1 ;;
      000)
        echo "  could not reach the broker at all — not installing. Network, or a wrong host."
        exit 1 ;;
      *)
        echo "  broker returned $CODE — not installing: $(head -c 200 /tmp/applyd-arm.out)"
        exit 1 ;;
    esac
    ;;

  smoke)
    need_env
    # The contract check. Verifies the worker and the broker agree on every
    # field before anything is driven for real — nothing is submitted, and a
    # packet claimed for inspection is handed straight back.
    cd "$HERE" && npm run --silent smoke
    ;;

  once)
    need_env
    # Exits as soon as the queue is dry. This is what launchd runs.
    cd "$HERE" && WORKER_IDLE_EXIT_MS="${WORKER_IDLE_EXIT_MS:-120000}" npm run --silent dev
    ;;

  watch)
    need_env
    # A real window, slowed down. Same adapters, same guards, same refusals as
    # production — only visibility changes. This is the mode for the first real
    # submission, where somebody needs to SEE which field got filled.
    cd "$HERE" && HEADLESS=false SLOW_MO=400 WORKER_IDLE_EXIT_MS=0 npm run --silent dev
    ;;

  install)
    need_env
    mkdir -p "$HOME/Library/LaunchAgents" "$HERE/mac"
    cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$HERE/mac/applyd</string>
    <string>once</string>
  </array>
  <!-- Every 5 minutes. Cheap because the worker asks the database whether
       there is anything to do BEFORE it starts a browser, and exits in about a
       second when there is not. -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- Deliberately NOT KeepAlive. This is a job that finishes, not a daemon;
       KeepAlive would restart it the instant it exited and defeat the whole
       point of exiting when the queue is dry. -->
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
  <key>WorkingDirectory</key><string>$HERE</string>
  <key>ProcessType</key><string>Background</string>
  <!-- Never wake a sleeping Mac to apply for jobs. If the laptop is shut, the
       run is skipped, the heartbeat goes stale, and apply-agent stops releasing
       — which is the correct behaviour, not a failure. -->
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
PLIST_EOF
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"
    echo "  installed: runs every 5 minutes, logs to $LOG"
    echo "  it exits in ~1s whenever there is nothing to send."
    ;;

  uninstall)
    launchctl unload "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"
    echo "  removed. Nothing scheduled."
    ;;

  status)
    if launchctl list | /usr/bin/grep -q "$LABEL"; then
      echo "  scheduled: yes"
      launchctl list "$LABEL" 2>/dev/null | /usr/bin/grep -E '"(PID|LastExitStatus)"' | sed 's/^/    /'
    else
      echo "  scheduled: no"
    fi
    [ -f "$LOG" ] && { echo "  last log lines:"; tail -6 "$LOG" | sed 's/^/    /'; } || echo "  no log yet"
    ;;

  logs) tail -f "$LOG" ;;

  *) sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
esac
