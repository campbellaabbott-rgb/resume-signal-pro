#!/bin/sh
# Pre-push gate: the full zero-bug battery before code leaves the machine.
#
# pre-commit runs a fast frontend typecheck on staged src changes. This hook is
# the heavier net that runs once per push (not per commit): the vitest suite
# always, plus the frontend typecheck and the edge-function deno gate WHEN the
# push actually touches those areas. The deno gate matters because `tsc` does
# not type-check Supabase edge functions — that blind spot shipped a live outage
# before, and the AI-spend edge bugs on 2026-07-13 pushed without any gate at all.
#
# Scope: compares HEAD against the upstream branch so a docs/config push stays
# instant. No upstream (first push of a branch) → run the full battery.
#
# Bypass an intentional WIP push with:  git push --no-verify

fail=0

range=""
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  range="@{u}...HEAD"
fi
if [ -n "$range" ]; then
  changed=$(git diff --name-only $range 2>/dev/null || echo "ALL")
else
  changed="ALL"
fi

run() { # label, command
  echo "[pre-push] $1…"
  if ! sh -c "$2"; then
    echo "[pre-push] ✗ $1 FAILED"
    fail=1
  fi
}

# 1. Tests — fast, always.
run "tests (vitest)" "npm run --silent test"

# 2. Frontend typecheck — only if src changed (or unknown scope).
if [ "$changed" = "ALL" ] || printf '%s\n' "$changed" | grep -qE '^src/.*\.(ts|tsx)$'; then
  run "frontend typecheck" "npm run --silent typecheck"
fi

# 3. Edge-function deno gate — only if edge functions changed (or unknown scope).
if [ "$changed" = "ALL" ] || printf '%s\n' "$changed" | grep -qE '^supabase/functions/'; then
  run "edge-function deno check" "npm run --silent check:functions"
fi

# 4. Apply-driver harness — only if the worker changed (or unknown scope).
#
# THIS IS THE ONLY THING THAT EXECUTES applyToPosting PAST THE CLICK. Everything
# else — vendor-adapters, broker-contract, the fixtures — compares selectors and
# field names against recordings. None of them press submit, wait for the page
# to settle, or run confirmed(). Those are the lines that decide whether a real
# person's application is recorded as SENT, and until now they were covered by a
# script nobody ran: no test invoked it, and ci.yml had never been committed, so
# it last executed by hand in July.
#
# The bug it exists to catch already happened once. "Thank you for your interest
# in this role" is ordinary job-ad copy that sits on the form page, so a submit
# that FAILED matched the phrase list and was recorded as sent — the application
# silently lost, and the duplicate guard then blocking the candidate from
# applying properly. Six scenarios now cover that plus silence, a foreign
# language, and a question the agent must refuse rather than guess.
#
# ~40s and it launches six browsers, which is why it is scoped to worker changes
# rather than run on every push.
if [ "$changed" = "ALL" ] || printf '%s\n' "$changed" | grep -qE '^worker/'; then
  run "apply-driver harness (past the click)" "cd worker && npm run --silent harness"
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-push] blocked — fix the failures above, or bypass a WIP push with: git push --no-verify"
  exit 1
fi
echo "[pre-push] ✓ all gates passed"
exit 0
